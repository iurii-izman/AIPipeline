{
  "name": "aipipeline",
  "version": "0.1.0-alpha.2",
  "description": "AI-native delivery pipeline scaffold",
  "private": true,
  "scripts": {
    "start": "node src/index.js",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run typecheck",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "eval:alpha": "node scripts/run-ai-eval.js --dataset evals/datasets/sentry-severity-alpha.json --model-tag alpha-heuristic-v1 --fail-on-gate",
    "eval:safety": "node scripts/run-ai-safety-eval.js --dataset evals/datasets/sentry-safety-alpha.json --model-tag safety-heuristic-v1 --fail-on-gate",
    "eval:v2": "node scripts/run-ai-eval-v2.js --dataset evals/datasets/sentry-severity-alpha.json --model-tag alpha-heuristic-v2 --fail-on-gate",
    "telemetry:seed": "node scripts/seed-ai-telemetry-from-eval.js --dataset evals/datasets/sentry-severity-alpha.json --limit 50 --clear-window",
    "telemetry:check-volume": "./scripts/check-online-telemetry-volume.sh --min-events 40 --strict",
    "telemetry:report": "node scripts/generate-online-telemetry-report.js --days 30 --min-events 40 --strict",
    "sbom:generate": "mkdir -p .out/sbom && cyclonedx-npm --output-file .out/sbom/cyclonedx-npm.json --output-format json",
    "provenance:generate": "./scripts/generate-provenance-pilot.sh",
    "supply-chain:verify": "./scripts/verify-supply-chain-evidence.sh --strict",
    "cost:report": "node scripts/generate-cost-report.js --days 30",
    "cost:budget": "node scripts/generate-cost-report.js --days 30 --strict-budget",
    "otel:check-coverage": "./scripts/check-otel-trace-coverage.sh --strict",
    "iac:validate": "./scripts/check-iac-baseline.sh",
    "dr:check-cadence": "./scripts/check-dr-cadence.sh --strict",
    "policy:data-governance": "./scripts/check-data-governance-policy.sh --strict",
    "release:scorecard:v2": "./scripts/generate-release-scorecard-v2.sh",
    "ops:backup-n8n": "./scripts/backup-n8n.sh",
    "ops:parity-check": "./scripts/check-env-parity.sh",
    "release:gate": "./scripts/release-quality-gate.sh",
    "coverage": "vitest run --coverage",
    "status": "./scripts/health-check-env.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.57.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@sentry/node": "^10.40.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^4.1.2",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.7.2",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
